      "code": "function validateSemanticContract(input) {\n  const context = readContext(input)\n  if (!ownsResource(context)) {\n    return reject('NOT_OWNED')\n  }\n  const result = applyArtifactEngine(context)\n  recordCliAndMcpAdapters(context.runId, result)\n  return result\n}",
